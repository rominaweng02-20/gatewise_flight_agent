<a href="/SystemEvents/GetNotices.asp?type=1&sys=4&qry=SELECT LOCID,YYYYMMDD ,SUM(OPS) AS TOTAL,SUM(DELAYS) AS DELAYS,SUM(TMI_IN) AS TMSS,SUM(DEP) AS DEPS,SUM(AIRBORNE_AT) AS ABRN,SUM(TMI_OUT) AS TMI_FROM,SUM(OCCURRED_AT) AS TOCC,SUM(AIRBORNE_TO) AS ABRN_DEST_TO,SUM(AC) AS AC,SUM(ATAXI) AS ATAXI,SUM(GA) AS GA,SUM(MIL) AS MIL,SUM(WX) AS WX,SUM(VOL) AS VOL,SUM(EQUIP) AS EQUIP,SUM(RW) AS RW,SUM(OTHER) AS OTHER,SUM(AVG_MIN*DELAYS)/IIF(SUM(DELAYS)=0,1,SUM(DELAYS)) AS AVG_MIN,SUM(AVG_MIN*DELAYS) AS TMINUTES,SUM(LOCAL_TMI) AS LOCAL_TMI,SUM(NON_LOCAL_TMI) AS NON_LOCAL_TMI,SUM(LOCAL_DEP) AS LOCAL_DEP  FROM DEL_DAILY WHERE YYYYMMDD>=20260401 AND YYYYMMDD<=20260831 AND LOCID IN ('LGA','EWR','JFK') GROUP BY LOCID,YYYYMMDD ORDER BY LOCID,YYYYMMDD&mod=28,5" target="_blank">Show data notices.</a></p>
